<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="MacroFactor.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MacroFactor.Views">

    <TabBar>
        <Tab Title="Dashboard" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <Tab Title="Add Food" Icon="plus.png">
            <ShellContent ContentTemplate="{DataTemplate views:AddFoodPage}" />
        </Tab>

        <Tab Title="Workout" Icon="dumbbell.png">
            <ShellContent ContentTemplate="{DataTemplate views:AddWorkoutPage}" />
        </Tab>
    </TabBar>

</Shell>