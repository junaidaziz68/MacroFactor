<ContentPage
    x:Class="MacroFactor.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111827}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Personalized greeting section, tied to the user's name later if we add a user model -->
            <Label Text="Welcome back, Bob!"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                   Margin="0,10,0,0"/>

            <Label Text="Here is your daily summary"
                   FontSize="16"
                   TextColor="#6B7280"
                   Margin="0,-15,0,20"/>

            <!-- Main Calories Card indicating remaining balance against the goal -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="24">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Calories Remaining" FontSize="16" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="{Binding TotalCalories, TargetNullValue='2100'}" 
                           FontSize="48" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#10B981, Dark=#34D399}" 
                           HorizontalOptions="Center" />
                    <Label Text="Goal: 2500 kcal" FontSize="14" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Macros Grid showing protein, carbs, and fats side-by-side for quick reference -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15" Margin="0,10,0,0">
                <!-- Protein -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}" Stroke="#E5E7EB" StrokeThickness="1" Padding="15,20">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Protein" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center"/>
                        <Label Text="120g" FontSize="20" FontAttributes="Bold" TextColor="#3B82F6" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Carbs -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}" Stroke="#E5E7EB" StrokeThickness="1" Padding="15,20">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Carbs" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center"/>
                        <Label Text="200g" FontSize="20" FontAttributes="Bold" TextColor="#F59E0B" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Fats -->
                <Border Grid.Column="2" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}" Stroke="#E5E7EB" StrokeThickness="1" Padding="15,20">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Fats" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center"/>
                        <Label Text="65g" FontSize="20" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Quick Action buttons to allow the user to immediately jump into logging their activity -->
            <Label Text="Quick Actions" FontSize="20" FontAttributes="Bold" Margin="0,20,0,0"/>

            <Button Text="+ Add Food"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

            <Button Text="+ Add Workout"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>