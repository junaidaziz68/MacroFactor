<ContentPage
    x:Class="MacroFactor.Views.AddFoodPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Food"
    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111827}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Page heading -->
            <Label Text="Log New Food"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                   Margin="0,10,0,10"/>

            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="20">
                
                <!-- Form fields grouped in a vertical stack for clean visual flow -->
                <VerticalStackLayout Spacing="15">
                    
                    <VerticalStackLayout Spacing="5">
                        <!-- We capture the name of the food item here -->
                        <Label Text="Food Name" TextColor="#6B7280" FontSize="14"/>
                        <Entry Placeholder="e.g., Chicken Breast" 
                               BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#374151}"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <!-- Total calories, using 'Numeric' keyboard to ensure only valid number input -->
                        <Label Text="Calories (kcal)" TextColor="#6B7280" FontSize="14"/>
                        <Entry Placeholder="0" 
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#374151}"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                    </VerticalStackLayout>

                    <!-- Group all three macros together into a 3-column grid to save vertical screen space -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <!-- Protein -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Protein (g)" TextColor="#6B7280" FontSize="14"/>
                            <Entry Placeholder="0" Keyboard="Numeric" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#374151}" TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        </VerticalStackLayout>

                        <!-- Carbs -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Carbs (g)" TextColor="#6B7280" FontSize="14"/>
                            <Entry Placeholder="0" Keyboard="Numeric" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#374151}" TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        </VerticalStackLayout>

                        <!-- Fats -->
                        <VerticalStackLayout Grid.Column="2" Spacing="5">
                            <Label Text="Fats (g)" TextColor="#6B7280" FontSize="14"/>
                            <Entry Placeholder="0" Keyboard="Numeric" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#374151}" TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="Log Food"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>